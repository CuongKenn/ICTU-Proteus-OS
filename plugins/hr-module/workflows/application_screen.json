{
  "_license": "Copyright (c) 2026 CuongKenn & ICTU Team | SPDX-License-Identifier: AGPL-3.0-or-later",
  "name": "HR - Application Screening (AI)",
  "nodes": [
    {
      "parameters": {
        "path": "hr/application-screen",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook - Screen Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "webhookId": "hr-application-screen-webhook"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT a.id, a.full_name, a.cover_note, p.title, p.requirements FROM {{TENANT_SCHEMA}}.hr_applications a LEFT JOIN {{TENANT_SCHEMA}}.hr_job_postings p ON p.id = a.posting_id WHERE a.id = $1;",
        "options": {
          "queryReplacement": "={{$json.body.application_id}}"
        }
      },
      "name": "Fetch Application",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.1,
      "position": [
        450,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "ProteusDB_Real"
        }
      }
    },
    {
      "parameters": {
        "model": "llama3",
        "options": {}
      },
      "name": "Ollama llama3",
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [
        450,
        550
      ],
      "credentials": {
        "ollamaApi": {
          "id": "uFKsNYmOauOi9E3J",
          "name": "OllamaLocal"
        }
      }
    },
    {
      "parameters": {
        "options": {},
        "prompt": "=Bạn là chuyên gia tuyển dụng. Chấm ứng viên cho vị trí sau theo thang 0-100 (kinh nghiệm, kỹ năng khớp yêu cầu, trình bày hồ sơ).\nVỊ TRÍ: {{ $('Fetch Application').item.json.title }}.\nYÊU CẦU: {{ $('Fetch Application').item.json.requirements }}.\nỨNG VIÊN: {{ $('Fetch Application').item.json.full_name }}. THƯ GIỚI THIỆU: {{ $('Fetch Application').item.json.cover_note }}.\nChỉ trả về JSON thuần, không giải thích: {\"score\": <số 0-100>, \"notes\": \"<nhận xét ngắn>\"}."
      },
      "name": "Score Chain",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const appId = $('Fetch Application').item.json.id;\nconst txt = ($input.first().json.text || '').trim();\nlet score = null, notes = txt.slice(0, 200);\ntry {\n  const m = txt.match(/\\{[\\s\\S]*\\}/);\n  if (m) { const o = JSON.parse(m[0]);\n    if (typeof o.score === 'number') score = Math.max(0, Math.min(100, Math.round(o.score)));\n    if (typeof o.notes === 'string') notes = o.notes.slice(0, 200); }\n} catch (e) {}\nreturn [{json: {application_id: appId, score, notes}}];"
      },
      "name": "Parse Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        850,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE {{TENANT_SCHEMA}}.hr_applications SET score = $1, screening_notes = $2, stage = 'SCREENING', updated_at = NOW() WHERE id = $3;",
        "options": {
          "queryReplacement": "={{$json.score}},={{$json.notes}},={{$json.application_id}}"
        }
      },
      "name": "Save Score",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.1,
      "position": [
        1050,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "ProteusDB_Real"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"success\": true, \"score\": \"{{$('Parse Score').item.json.score}}\"}"
      },
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1250,
        300
      ]
    }
  ],
  "connections": {
    "Webhook - Screen Request": {
      "main": [
        [
          {
            "node": "Fetch Application",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Application": {
      "main": [
        [
          {
            "node": "Score Chain",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ollama llama3": {
      "ai_languageModel": [
        [
          {
            "node": "Score Chain",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Score Chain": {
      "main": [
        [
          {
            "node": "Parse Score",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Score": {
      "main": [
        [
          {
            "node": "Save Score",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save Score": {
      "main": [
        [
          {
            "node": "Respond OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
