  "name": "Asset Overview",
  "description": "Metabase dashboard for Asset Overview",
  "cards": [
    {
      "name": "Tổng Tài Sản",
      "display": "scalar",
      "dataset_query": {
        "type": "native",
        "native": {
          "query": "SELECT COUNT(*) FROM {{TENANT_SCHEMA}}.asset_items",
          "template-tags": {"tenant_id": {"type": "text", "required": true}}
        }
      }
    },
    {
      "name": "Tài Sản Theo Trạng Thái",
      "display": "pie",
      "dataset_query": {
        "type": "native",
        "native": {
          "query": "SELECT status, COUNT(*) as count FROM {{TENANT_SCHEMA}}.asset_items GROUP BY status",
          "template-tags": {"tenant_id": {"type": "text", "required": true}}
        }
      }
    },
    {
      "name": "Tài Sản Theo Phòng Ban",
      "display": "bar",
      "dataset_query": {
        "type": "native",
        "native": {
          "query": "SELECT c.name as location, COUNT(*) as count FROM {{TENANT_SCHEMA}}.asset_items a JOIN {{TENANT_SCHEMA}}.asset_categories c ON a.category_id = c.id GROUP BY c.name ORDER BY count DESC",
          "template-tags": {"tenant_id": {"type": "text", "required": true}}
        }
      }
    }
  ],
  "collection": "asset-module",
  "parameters": [{"name": "tenant_id", "slug": "tenant_id", "type": "string", "required": true}]
}
